{
  "manifest_version": 3,
  "name": "NordTime",
  "short_name": "NordTime",
  "version": "1.0.1",
  "description": "Automatically matches your browser's time zone to the location of your current IP address (VPN-aware).",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/LeerBox/NordTime",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NordTime",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "webRequest",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
